# Mock 模式：auto | 1 | 0
# auto = 自动检测（有真实服务走真实，否则 Mock）
# 1   = 强制 Mock
# 0   = 强制真实（缺服务则报错）
LOCAL_AI_MOCK=auto

# 各模型服务地址（Docker 内部通信）
ASR_URL=http://asr:8001
TRANSLATE_URL=http://translate:8002
TTS_URL=http://tts:8004
NLP_URL=http://nlp:8005
MTRAN_URL=http://mtran:8989

# TTS 默认中文语音
# zh_CN-xiao_ya-medium = 拼音方案，停顿更自然（依赖 g2pW，约 152MB 首次下载）
# zh_CN-huayan-medium  = espeak 方案，中英混读略好
TTS_PIPER_VOICE=zh_CN-xiao_ya-medium

# NLP 推理线程数；留空 = 自动取物理核心数
# ⚠️ 不要填逻辑核数（含超线程）：实测 i5-10400 上 12 线程比 6 线程慢 28 倍
NLP_N_THREADS=
# NLP 上下文长度（KV cache 约 144KB/token）
NLP_N_CTX=4096

# 模型下载源（国内用 hf-mirror；海外可改为 https://huggingface.co）
# 影响两处：TTS 拉取 g2pW 注音模型、Web 面板「模型管理」页的模型下载
# 注意：命令行脚本 scripts/download-models.sh 读的是另一个变量 HF_MIRROR
HF_ENDPOINT=https://hf-mirror.com
